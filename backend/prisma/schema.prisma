// Prisma Schema for SANA MVP
// Database: PostgreSQL (Neon)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum UserRole {
  CLIENT
  PRACTITIONER
  ADMIN
}

enum VerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum OutcomeRating {
  MUCH_BETTER
  SLIGHTLY_BETTER
  SAME
  SLIGHTLY_WORSE
  MUCH_WORSE
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_1H
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED
  SESSION_NOTE_ADDED
  OUTCOME_RECORDED
  PRACTITIONER_VERIFIED
  PRACTITIONER_REJECTED
  NEW_MESSAGE
  REVIEW_RECEIVED
  SYSTEM_ANNOUNCEMENT
}

// Models
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?
  name          String
  role          UserRole @default(CLIENT)

  googleId      String?  @unique
  profilePhoto  String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastLoginAt   DateTime?

  clientProfile       ClientProfile?
  practitionerProfile PractitionerProfile?
  clientAppointments  Appointment[] @relation("ClientAppointments")
  practitionerAppointments Appointment[] @relation("PractitionerAppointments")
  notifications       Notification[]
  notificationPreference NotificationPreference?
  clientConversations Conversation[] @relation("ClientConversations")
  practitionerConversations Conversation[] @relation("PractitionerConversations")
  sentMessages        Message[] @relation("SentMessages")
  receivedMessages    Message[] @relation("ReceivedMessages")

  @@index([email])
  @@index([googleId])
}

model ClientProfile {
  id              String   @id @default(cuid())
  userId          String   @unique

  // Health Questionnaire
  questionnaireCompleted Boolean @default(false)
  questionnaireData      Json?

  // SANA Health Score
  currentScore    Int      @default(0)
  currentStatus   String?  // NEEDS_SUPPORT, REBUILDING, BALANCED, THRIVING, RADIANT
  domainScores    Json?    // {physical, mental, lifestyle, social}

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCheckins   DailyCheckin[]
  journals        Journal[]
  outcomes        ClientOutcome[]
  reviews         Review[]

  @@index([userId])
}

model PractitionerProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  practiceName      String?
  bio               String?  @db.Text
  postcode          String?
  phone             String?
  website           String?

  // Professional info
  specialties       String[] // Array of strings
  modalities        String[]
  languagesSpoken   String[]
  yearsOfPractice   Int?
  qualifications    String?  @db.Text

  // Verification
  verificationStatus VerificationStatus @default(PENDING)
  credentialFiles   String[] // S3 URLs
  verifiedBadges    String[] // CNHC, GHR, FHT, etc.

  // SANA Index
  sanaIndexScore    Int      @default(0)
  sanaIndexPublic   Boolean  @default(true)

  // Availability
  availabilityData  Json? // Recurring schedule

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTypes         SessionType[]
  appointments         Appointment[]
  sessionNotes         SessionNote[]
  stripeAccount        StripeAccount?
  reviews              Review[]
  availabilitySlots    AvailabilitySlot[]
  timeOffs             TimeOff[]
  availabilityOverrides AvailabilityOverride[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([postcode])
}

model SessionType {
  id            String  @id @default(cuid())
  practitionerId String
  name          String  // "Initial Consultation"
  duration      Int     // minutes
  price         Int     // pence (e.g., 5000 = £50.00)
  description   String? @db.Text
  isActive      Boolean @default(true)
  availableFor  String  // "in-person" | "remote" | "both"

  practitioner  PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  appointments  Appointment[]

  @@index([practitionerId])
}

model Appointment {
  id             String            @id @default(cuid())
  clientId       String
  practitionerId String
  sessionTypeId  String

  scheduledAt    DateTime
  duration       Int               // minutes
  status         AppointmentStatus @default(SCHEDULED)

  // Location
  isRemote       Boolean
  zoomLink       String?
  address        String?

  // Payment
  stripePaymentId String?
  amountPaid      Int?            // pence

  // Notes
  clientNotes    String?          @db.Text

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  client        User                @relation("ClientAppointments", fields: [clientId], references: [id])
  practitioner  User                @relation("PractitionerAppointments", fields: [practitionerId], references: [id])
  sessionType   SessionType         @relation(fields: [sessionTypeId], references: [id])
  sessionNote   SessionNote?
  outcome       ClientOutcome?
  review        Review?

  @@index([clientId])
  @@index([practitionerId])
  @@index([scheduledAt])
  @@index([status])
}

model SessionNote {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  practitionerId String

  subjective     String?  @db.Text
  objective      String?  @db.Text
  assessment     String?  @db.Text
  plan           String?  @db.Text
  treatmentData  Json?    // Structured treatment items
  privateNotes   String?  @db.Text

  finalized      Boolean  @default(false)
  finalizedAt    DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  appointment   Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  practitioner  PractitionerProfile @relation(fields: [practitionerId], references: [id])

  @@index([appointmentId])
  @@index([practitionerId])
}

model ClientOutcome {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  clientId      String

  rating        OutcomeRating
  wouldRecommend Boolean?
  comments      String?       @db.Text

  recordedAt    DateTime      @default(now())

  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client        ClientProfile  @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([appointmentId])
}

model DailyCheckin {
  id        String   @id @default(cuid())
  clientId  String
  date      DateTime @default(now())

  sleepQuality Int // 1-5
  energyLevel  Int // 1-5
  mood         Int // 1-5
  stressLevel  Int // 1-5

  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, date])
  @@index([clientId])
  @@index([date])
}

model Journal {
  id        String   @id @default(cuid())
  clientId  String
  content   String   @db.Text
  mood      Int?     // 1-5
  tags      String[] // #sleep, #mood, etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client    ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([createdAt])
}

model StripeAccount {
  id              String   @id @default(cuid())
  practitionerId  String   @unique
  stripeAccountId String   @unique
  enabled         Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([stripeAccountId])
}

model RecommendationTemplate {
  id          String   @id @default(cuid())
  slug        String   @unique // "improve-sleep"
  title       String   // "Improve Your Sleep"
  category    String   // "Sleep", "Stress", etc.
  content     String   @db.Text // Markdown content
  citations   Json     // Array of research links

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([slug])
}

// Phase 4: Notifications Module
model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  message     String           @db.Text
  data        Json?            // Additional context (appointmentId, etc.)

  // Delivery status
  read        Boolean          @default(false)
  readAt      DateTime?
  sent        Boolean          @default(false)
  sentAt      DateTime?

  // Channels
  emailSent   Boolean          @default(false)
  smsSent     Boolean          @default(false)
  pushSent    Boolean          @default(false)

  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([type])
}

model NotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String   @unique

  // Channel preferences
  emailEnabled           Boolean  @default(true)
  smsEnabled             Boolean  @default(false)
  pushEnabled            Boolean  @default(true)

  // Notification type preferences
  appointmentReminders   Boolean  @default(true)
  appointmentUpdates     Boolean  @default(true)
  paymentNotifications   Boolean  @default(true)
  sessionNotes           Boolean  @default(true)
  outcomeNotifications   Boolean  @default(true)
  messageNotifications   Boolean  @default(true)
  promotionalEmails      Boolean  @default(false)
  systemAnnouncements    Boolean  @default(true)

  // Phone for SMS (optional)
  phoneNumber            String?

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Phase 4 Module 3: Reviews & Ratings
model Review {
  id                String   @id @default(cuid())
  practitionerId    String
  clientId          String
  appointmentId     String   @unique // One review per appointment

  // Rating & Review
  rating            Int      // 1-5 stars
  title             String?  // Optional review title
  comment           String?  @db.Text // Optional review text
  
  // Moderation
  isPublished       Boolean  @default(true) // Can be hidden by admin/practitioner
  
  // Reply from practitioner
  practitionerReply String?  @db.Text
  repliedAt         DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  practitioner      PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  client            ClientProfile @relation(fields: [clientId], references: [id], onDelete: Cascade)
  appointment       Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([practitionerId, isPublished])
  @@index([clientId])
  @@index([appointmentId])
  @@index([rating])
  @@index([createdAt])
}

// Phase 4 Module 5: In-App Messaging
model Conversation {
  id              String   @id @default(cuid())
  clientId        String
  practitionerId  String
  appointmentId   String?  // Optional: link to specific appointment

  // Last message info for conversation list
  lastMessageText String?  @db.Text
  lastMessageAt   DateTime?

  // Unread counts
  clientUnread    Int      @default(0)
  practitionerUnread Int   @default(0)

  // Archive status
  clientArchived  Boolean  @default(false)
  practitionerArchived Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          User     @relation("ClientConversations", fields: [clientId], references: [id], onDelete: Cascade)
  practitioner    User     @relation("PractitionerConversations", fields: [practitionerId], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([clientId, practitionerId]) // One conversation per client-practitioner pair
  @@index([clientId])
  @@index([practitionerId])
  @@index([lastMessageAt])
}

model Message {
  id              String       @id @default(cuid())
  conversationId  String
  senderId        String
  receiverId      String

  text            String?      @db.Text
  attachmentUrl   String?      // S3 URL for images/files
  attachmentType  String?      // "image" | "document" | null

  // Read status
  read            Boolean      @default(false)
  readAt          DateTime?

  // Metadata
  isSystemMessage Boolean      @default(false) // Auto-generated messages
  metadata        Json?        // Additional data (e.g., booking confirmation)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver        User         @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@index([read])
}

// Phase 4 Module 6: Calendar & Scheduling
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
}

model AvailabilitySlot {
  id              String   @id @default(cuid())
  practitionerId  String

  // Recurring availability pattern
  dayOfWeek       DayOfWeek
  startTime       String   // Format: "09:00"
  endTime         String   // Format: "17:00"

  // Effective date range (for seasonal schedules)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?

  // Template/label (e.g., "Summer Schedule", "Default")
  label           String?
  isActive        Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([dayOfWeek])
  @@index([isActive])
}

model TimeOff {
  id              String        @id @default(cuid())
  practitionerId  String

  // Time off period
  startDate       DateTime
  endDate         DateTime

  // Reason and status
  reason          String?       @db.Text
  status          TimeOffStatus @default(PENDING)

  // Admin approval
  approvedBy      String?
  approvedAt      DateTime?

  // Notes
  notes           String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([startDate, endDate])
  @@index([status])
}

model AvailabilityOverride {
  id              String   @id @default(cuid())
  practitionerId  String

  // Specific date override
  date            DateTime

  // Override times (if null, day is blocked entirely)
  startTime       String?  // Format: "09:00"
  endTime         String?  // Format: "17:00"

  // Reason for override
  reason          String?  @db.Text
  isAvailable     Boolean  @default(true) // false = blocked day

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId])
  @@index([date])
}

